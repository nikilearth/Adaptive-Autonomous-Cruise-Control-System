  frame_00
};

const uint8_t FRAME_COUNT = 1;

const uint16_t FRAME_DELAY = 100; // ms
// -------- MAIN LOOP --------
void setup() {

  Serial.begin(115200);

  // Initialize I2C for ESP32
  Wire.begin(OLED_SDA, OLED_SCL);

  // Initialize OLED
 if (!display.begin(OLED_ADDRESS, true)) {
    Serial.println("OLED initialization failed!");
    while (true);
  }

  Serial.println("OLED initialized successfully!");

  display.clearDisplay();
  display.display();
}

void loop() {

  for (uint8_t i = 0; i < FRAME_COUNT; i++) {

    display.clearDisplay();

    const uint8_t* bitmap =
      (const uint8_t*)pgm_read_ptr(&frames[i]);

    display.drawBitmap(
      0,
      0,
      bitmap,
      SCREEN_WIDTH,
      SCREEN_HEIGHT,
      SH110X_WHITE
    );

    display.display();

    
  }
}